# Copy this file to ".env" and fill it in. Never commit the real .env.
# Gmail values: see SETUP.md.  WhatsApp + Pub/Sub values: see WHATSAPP-SETUP.md.

# ---- Google OAuth (Gmail) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match the Authorized redirect URI on your OAuth client exactly.
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback

PORT=3000

# ---- WhatsApp Cloud API (Meta) ----
# From Meta for Developers > your app > WhatsApp > API Setup.
WA_PHONE_NUMBER_ID=123456789012345
WA_ACCESS_TOKEN=EAAG...

# App Settings > Basic > App Secret. Used to verify webhook signatures.
WA_APP_SECRET=your-app-secret

# Any random string you invent. You type the same value into Meta's webhook config.
WA_VERIFY_TOKEN=pick-a-long-random-string

# The message template Meta approved, used outside the 24-hour free-form window.
# It must have exactly three body variables: {{1}} sender, {{2}} subject, {{3}} preview.
WA_TEMPLATE_NAME=new_email_alert
WA_TEMPLATE_LANG=en

# ---- Gmail push via Google Cloud Pub/Sub ----
# The topic Gmail publishes to, in full resource form.
PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push

# Another random string. It goes in the push subscription URL as ?token=... and is
# what stops anyone else posting fake mail notifications to your webhook.
PUBSUB_VERIFICATION_TOKEN=pick-another-long-random-string

# ---- Deployment (leave unset when running locally) ----
# Bind address. Set to 127.0.0.1 behind Nginx so the app is not exposed directly.
# HOST=127.0.0.1

# Number of proxy hops in front of the app. 1 for a single Nginx in front.
# TRUST_PROXY=1

# Secret for the daily watch-renewal cron. Invent another long random string.
# Call it as: https://your-domain/cron/renew?token=THIS_VALUE
# CRON_TOKEN=pick-a-third-long-random-string
