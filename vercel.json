{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/api" }
  ],

  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },

  "crons": [
    {
      "path": "/cron/renew",
      "schedule": "0 4 * * *"
    }
  ]
}
