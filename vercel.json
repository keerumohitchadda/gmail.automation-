{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ],

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/webhook/(.*)", "destination": "/api" },
    { "source": "/cron/(.*)", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/oauth2callback", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" }
  ],

  "crons": [
    {
      "path": "/cron/renew",
      "schedule": "0 4 * * *"
    }
  ]
}
