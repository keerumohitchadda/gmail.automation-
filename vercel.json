{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],

  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },

  "crons": [
    {
      "path": "/cron/renew",
      "schedule": "0 4 * * *"
    }
  ]
}
